<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane fitToWidth="true"
            style="-fx-background: #F5EFE6; -fx-background-color: #F5EFE6;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kafepos.ReportsController">

    <content>
        <VBox spacing="24"
              style="-fx-background-color: #F5EFE6; -fx-padding: 32;">

            <!-- HEADER -->
            <VBox spacing="6">
                <Label text="Reports"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                <Label text="Track your cafe performance and business insights."
                       style="-fx-font-size: 13px; -fx-text-fill: #8B8179;"/>
            </VBox>

            <!-- FILTER -->
            <HBox spacing="12" alignment="CENTER_LEFT">

                <ComboBox fx:id="periodFilter"
                          promptText="Select Period"
                          prefWidth="170"
                          style="-fx-background-color: white; -fx-background-radius: 8;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Today"/>
                            <String fx:value="This Week"/>
                            <String fx:value="This Month"/>
                            <String fx:value="This Year"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Export Report"
                        onAction="#exportReport"
                        style="-fx-background-color: #8B6B4F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
            </HBox>

            <!-- SUMMARY CARDS -->
            <HBox spacing="18">

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">
                    <Label text="Total Revenue"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 13px;"/>
                    <Label fx:id="totalRevenueLabel"
                           text="Rp16.500.000"
                           style="-fx-text-fill: #2B211D; -fx-font-size: 23px; -fx-font-weight: bold;"/>
                    <Label text="Revenue in selected period"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">
                    <Label text="Total Orders"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 13px;"/>
                    <Label fx:id="totalOrdersLabel"
                           text="168"
                           style="-fx-text-fill: #2B211D; -fx-font-size: 23px; -fx-font-weight: bold;"/>
                    <Label text="Orders in selected period"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">
                    <Label text="Average Order Value"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 13px;"/>
                    <Label fx:id="averageOrderValueLabel"
                           text="Rp98.214"
                           style="-fx-text-fill: #2B211D; -fx-font-size: 23px; -fx-font-weight: bold;"/>
                    <Label text="Revenue per order"
                           style="-fx-text-fill: #8B8179; -fx-font-size: 12px;"/>
                </VBox>

            </HBox>

            <!-- REVENUE CHART -->
            <VBox spacing="16"
                  minHeight="380"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">

                <VBox spacing="5">
                    <Label text="Revenue Overview"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                    <Label fx:id="revenueSubtitleLabel"
                           text="Revenue performance this month"
                           style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
                </VBox>

                <BarChart fx:id="revenueChart"
                          prefHeight="300"
                          VBox.vgrow="ALWAYS"
                          legendVisible="false"
                          animated="false"
                          style="-fx-background-color: transparent;">

                    <xAxis>
                        <CategoryAxis label="Period"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis label="Revenue (Rp)"
                                    forceZeroInRange="true"/>
                    </yAxis>

                </BarChart>
            </VBox>

            <!-- LOWER REPORTS -->
            <HBox spacing="18" alignment="TOP_LEFT">

                <!-- TOP SELLING PRODUCTS -->
                <VBox spacing="16"
                      HBox.hgrow="ALWAYS"
                      minHeight="340"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">

                    <VBox spacing="5">
                        <Label text="Top Selling Products"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                        <Label text="Best performing products"
                               style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
                    </VBox>

                    <BarChart fx:id="topProductsChart"
                              prefHeight="260"
                              VBox.vgrow="ALWAYS"
                              legendVisible="false"
                              animated="false">

                        <xAxis>
                            <CategoryAxis label="Product"/>
                        </xAxis>

                        <yAxis>
                            <NumberAxis label="Units Sold"
                                        forceZeroInRange="true"/>
                        </yAxis>

                    </BarChart>
                </VBox>

                <!-- PAYMENT SUMMARY -->
                <VBox spacing="18"
                      HBox.hgrow="ALWAYS"
                      minHeight="340"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">

                    <VBox spacing="5">
                        <Label text="Payment Summary"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                        <Label text="Revenue by payment method"
                               style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
                    </VBox>

                    <VBox spacing="18">

                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Cash"
                                       style="-fx-font-size: 13px; -fx-text-fill: #5E5148;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cashAmountLabel"
                                       text="Rp4.950.000"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                            </HBox>
                            <ProgressBar fx:id="cashProgress"
                                         progress="0.30"
                                         maxWidth="Infinity"
                                         prefHeight="10"/>
                            <Label fx:id="cashPercentLabel"
                                   text="30%"
                                   style="-fx-font-size: 11px; -fx-text-fill: #8B8179;"/>
                        </VBox>

                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Card"
                                       style="-fx-font-size: 13px; -fx-text-fill: #5E5148;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cardAmountLabel"
                                       text="Rp3.300.000"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                            </HBox>
                            <ProgressBar fx:id="cardProgress"
                                         progress="0.20"
                                         maxWidth="Infinity"
                                         prefHeight="10"/>
                            <Label fx:id="cardPercentLabel"
                                   text="20%"
                                   style="-fx-font-size: 11px; -fx-text-fill: #8B8179;"/>
                        </VBox>

                        <VBox spacing="6">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="QRIS"
                                       style="-fx-font-size: 13px; -fx-text-fill: #5E5148;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="qrisAmountLabel"
                                       text="Rp8.250.000"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                            </HBox>
                            <ProgressBar fx:id="qrisProgress"
                                         progress="0.50"
                                         maxWidth="Infinity"
                                         prefHeight="10"/>
                            <Label fx:id="qrisPercentLabel"
                                   text="50%"
                                   style="-fx-font-size: 11px; -fx-text-fill: #8B8179;"/>
                        </VBox>

                    </VBox>
                </VBox>

            </HBox>

            <!-- SALES PERFORMANCE -->
            <VBox spacing="16"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">

                <VBox spacing="5">
                    <Label text="Sales Performance"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                    <Label text="Performance overview for the selected period"
                           style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
                </VBox>

                <HBox spacing="18">

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">
                        <Label text="Revenue Growth"
                               style="-fx-font-size: 13px; -fx-text-fill: #8B8179;"/>
                        <Label fx:id="revenueGrowthLabel"
                               text="+12.5%"
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #3D8054;"/>
                        <Label text="Compared to previous period"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B8179;"/>
                    </VBox>

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">
                        <Label text="Order Growth"
                               style="-fx-font-size: 13px; -fx-text-fill: #8B8179;"/>
                        <Label fx:id="orderGrowthLabel"
                               text="+8.2%"
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #3D8054;"/>
                        <Label text="Compared to previous period"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B8179;"/>
                    </VBox>

                </HBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>