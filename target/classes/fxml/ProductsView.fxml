<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24"
      style="-fx-background-color: #F5EFE6; -fx-padding: 32;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kafepos.ProductsController">

    <!-- HEADER -->
    <VBox spacing="7">
        <Label text="Products"
               style="-fx-font-size: 27px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2B211D;"/>

        <Label text="Manage your cafe menu and product inventory."
               style="-fx-font-size: 13px;
                      -fx-text-fill: #8A817C;"/>
    </VBox>

    <!-- TOOLBAR -->
    <HBox spacing="12" alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search products..."
                   prefWidth="280"
                   style="-fx-background-color: white;
                          -fx-background-radius: 8;
                          -fx-padding: 10;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Edit Selected"
                onAction="#handleEditProduct"
                style="-fx-background-color: #E6D8C8;
                       -fx-text-fill: #2B211D;
                       -fx-background-radius: 8;
                       -fx-padding: 10 16;
                       -fx-cursor: hand;"/>

        <Button text="Delete Selected"
                onAction="#handleDeleteProduct"
                style="-fx-background-color: #F2D6D2;
                       -fx-text-fill: #8B3830;
                       -fx-background-radius: 8;
                       -fx-padding: 10 16;
                       -fx-cursor: hand;"/>

        <Button text="+ Add Product"
                onAction="#handleAddProduct"
                style="-fx-background-color: #2B211D;
                       -fx-text-fill: white;
                       -fx-background-radius: 8;
                       -fx-padding: 10 18;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

    </HBox>

    <!-- PRODUCT TABLE -->
    <TableView fx:id="productTable"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;
                      -fx-background-radius: 12;">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>

            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="55"/>

            <TableColumn fx:id="imageColumn"
                         text="Image"
                         prefWidth="85"/>

            <TableColumn fx:id="nameColumn"
                         text="Product Name"
                         prefWidth="180"/>

            <TableColumn fx:id="categoryColumn"
                         text="Category"
                         prefWidth="130"/>

            <TableColumn fx:id="priceColumn"
                         text="Price"
                         prefWidth="120"/>

            <TableColumn fx:id="stockColumn"
                         text="Stock"
                         prefWidth="75"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="90"/>

        </columns>

    </TableView>

</VBox>