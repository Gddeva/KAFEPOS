<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kafepos.SettingsController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #F5EFE6; -fx-background: #F5EFE6;">

    <VBox spacing="24" style="-fx-background-color: #F5EFE6; -fx-padding: 32;">

        <!-- HEADER -->
        <VBox spacing="6">
            <Label text="Settings"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
            <Label text="Configure your cafe profile and pricing."
                   style="-fx-font-size: 13px; -fx-text-fill: #8B8179;"/>
        </VBox>

        <!-- CAFE PROFILE -->
        <VBox fx:id="profileCard" spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
            <VBox spacing="4">
                <Label text="Cafe Profile"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                <Label text="Basic information about your cafe."
                       style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Cafe Name" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <TextField fx:id="cafeNameField"
                               style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Phone" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <TextField fx:id="phoneField"
                               style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Address" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                <TextField fx:id="addressField"
                           style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
            </VBox>
        </VBox>

        <!-- TAX AND SERVICE -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
            <VBox spacing="4">
                <Label text="Tax &amp; Service Charge"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                <Label text="Applied automatically to every new order."
                       style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Tax / PPN (%)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <TextField fx:id="taxField"
                               style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Service Charge (%)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <TextField fx:id="serviceField"
                               style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="saveButton" text="Save Settings" onAction="#handleSave"
                        style="-fx-background-color: #8B6B4F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18; -fx-cursor: hand;"/>
                <Button fx:id="reloadButton" text="Reset" onAction="#handleReload"
                        style="-fx-background-color: #E9DFD5; -fx-text-fill: #5B4030; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18; -fx-cursor: hand;"/>
                <Label fx:id="statusLabel" style="-fx-font-size: 12px;"/>
            </HBox>
        </VBox>

        <!-- MY ACCOUNT -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
            <VBox spacing="4">
                <Label fx:id="accountTitle" text="My Account"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>
                <Label text="Change the password of the account you are signed in with."
                       style="-fx-font-size: 12px; -fx-text-fill: #8B8179;"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Current Password" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <PasswordField fx:id="oldPassField"
                                   style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="New Password" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <PasswordField fx:id="newPassField"
                                   style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Confirm New Password" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8A817C;"/>
                    <PasswordField fx:id="confirmPassField"
                                   style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Update Password" onAction="#handleChangePassword"
                        style="-fx-background-color: #2B211D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18; -fx-cursor: hand;"/>
                <Label fx:id="passwordStatusLabel" style="-fx-font-size: 12px;"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
