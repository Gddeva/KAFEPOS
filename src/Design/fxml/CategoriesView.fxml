<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24" style="-fx-background-color: #F5EFE6; -fx-padding: 32;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kafepos.CategoriesController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B211D;" text="Categories" />

            <Label style="-fx-font-size: 13px; -fx-text-fill: #8B6B4F;" text="Manage your menu categories" />
        </VBox>

        <Button onAction="#handleAddCategory" style="-fx-background-color: #2B211D; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20;" text="+ Add Category" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" prefWidth="280" promptText="Search category..." style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12;" />

        <Button onAction="#handleSearch" style="-fx-background-color: #8B6B4F; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20;" text="Search" />
    </HBox>

    <TableView fx:id="categoryTable" style="-fx-background-color: white; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80" text="ID" />

            <TableColumn fx:id="nameColumn" prefWidth="300" text="Category Name" />

            <TableColumn fx:id="actionColumn" prefWidth="200" text="Actions" />
        </columns>
    </TableView>

</VBox>
