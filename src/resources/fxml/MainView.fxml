<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1250.0"
            fx:controller="com.kafepos.MainController"
            fx:id="rootLayout"

            stylesheets="@../css/style.css"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <Label text="KAFEPOS" styleClass="brand-title"/>
            <Label text="CAFE MANAGEMENT SYSTEM" styleClass="brand-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Administrator" styleClass="admin-label"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="220" spacing="12" styleClass="sidebar">

            <Label text="MAIN MENU" styleClass="sidebar-caption"/>

            <Button text="Dashboard"
        styleClass="sidebar-button"
        onAction="#showDashboard"/>
            <Button text="Products"
        styleClass="sidebar-button"
        onAction="#showProducts"/>
            <Button text="Categories"
        styleClass="sidebar-button"
        onAction="#showCategories"/>
            <Button text="Transactions"
        styleClass="sidebar-button"
        onAction="#showTransactions"/>
            <Button text="Orders"
        styleClass="sidebar-button"
        onAction="#showOrders"/>
            <Button text="Reports"
        styleClass="sidebar-button"
        onAction="#showReports"/>
            <Button text="Users" styleClass="sidebar-button"/>
            <Button text="Settings" styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="KAFEPOS  •  Version 1.0" styleClass="sidebar-footer"/>

        </VBox>
    </left>

    <!-- DASHBOARD CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <content>
                <VBox spacing="24" styleClass="dashboard-content" fillWidth="true">

                    <!-- PAGE TITLE -->
                    <VBox spacing="7">
                        <Label text="Dashboard Overview" styleClass="page-title"/>
                        <Label text="Manage your cafe operations at a glance."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <!-- STATISTIC CARDS -->
                    <HBox spacing="18" styleClass="stats-row">

                        <VBox spacing="10" styleClass="stat-card">
                            <Label text="TOTAL SALES" styleClass="stat-label"/>
                            <Label text="Rp 12.500.000" styleClass="stat-value"/>
                            <Label text="+12.5% from last month" styleClass="stat-note"/>
                        </VBox>

                        <VBox spacing="10" styleClass="stat-card">
                            <Label text="TOTAL ORDERS" styleClass="stat-label"/>
                            <Label text="1.284" styleClass="stat-value"/>
                            <Label text="+8.2% from last month" styleClass="stat-note"/>
                        </VBox>

                        <VBox spacing="10" styleClass="stat-card">
                            <Label text="TOTAL PRODUCTS" styleClass="stat-label"/>
                            <Label text="156" styleClass="stat-value"/>
                            <Label text="Available in inventory" styleClass="stat-note"/>
                        </VBox>

                        <VBox spacing="10" styleClass="stat-card">
                            <Label text="TOTAL REVENUE" styleClass="stat-label"/>
                            <Label text="Rp 8.750.000" styleClass="stat-value"/>
                            <Label text="This month" styleClass="stat-note"/>
                        </VBox>

                    </HBox>

                    <!-- RECENT TRANSACTIONS -->
                    <VBox spacing="12" styleClass="content-section" maxWidth="Infinity">

                        <VBox spacing="5">
                            <Label text="Recent Transactions" styleClass="section-title"/>
                            <Label text="A quick look at your latest cafe transactions."
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <TableView prefHeight="270"
           maxWidth="Infinity"
           styleClass="transaction-table">
                            <placeholder>
                                <Label text="No transactions available yet."/>
                            </placeholder>
                            <columns>
                                <TableColumn text="Transaction ID" prefWidth="220"/>
                                <TableColumn text="Date" prefWidth="200"/>
                                <TableColumn text="Customer" prefWidth="350"/>
                                <TableColumn text="Amount" prefWidth="300"/>
                            </columns>
                        </TableView>

                    </VBox>

                    <!-- POPULAR PRODUCTS -->
                    <VBox spacing="14" styleClass="content-section">

                        <VBox spacing="5">
                            <Label text="Popular Products" styleClass="section-title"/>
                            <Label text="Your cafe's best-selling menu items."
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <HBox spacing="18">

                            <VBox spacing="9" styleClass="product-card">
                                <Label text="01" styleClass="product-number"/>
                                <Label text="Iced Americano" styleClass="product-name"/>
                                <Label text="128 orders" styleClass="product-detail"/>
                            </VBox>

                            <VBox spacing="9" styleClass="product-card">
                                <Label text="02" styleClass="product-number"/>
                                <Label text="Cafe Latte" styleClass="product-name"/>
                                <Label text="96 orders" styleClass="product-detail"/>
                            </VBox>

                            <VBox spacing="9" styleClass="product-card">
                                <Label text="03" styleClass="product-number"/>
                                <Label text="Chocolate Cake" styleClass="product-name"/>
                                <Label text="74 orders" styleClass="product-detail"/>
                            </VBox>

                        </HBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>