<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24"
      style="-fx-background-color: #F5EFE6; -fx-padding: 32;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kafepos.TransactionsController">


    <!-- PAGE HEADER -->
    <VBox spacing="7">
        <Label text="Transactions"
               style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

        <Label text="Monitor and manage your cafe's payment activities."
               style="-fx-font-size: 13px; -fx-text-fill: #8A817C;"/>
    </VBox>

    <!-- SUMMARY CARDS -->
    <HBox spacing="18">

        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">

            <Label text="TOTAL TRANSACTIONS"
                   style="-fx-font-size: 11px; -fx-text-fill: #8A817C; -fx-font-weight: bold;"/>

            <Label text="1,284"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

            <Label text="+8.2% from last month"
                   style="-fx-font-size: 11px; -fx-text-fill: #4D8B65;"/>

        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">

            <Label text="TOTAL SALES"
                   style="-fx-font-size: 11px; -fx-text-fill: #8A817C; -fx-font-weight: bold;"/>

            <Label text="Rp 12.500.000"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

            <Label text="+12.5% from last month"
                   style="-fx-font-size: 11px; -fx-text-fill: #4D8B65;"/>

        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;">

            <Label text="PENDING PAYMENTS"
                   style="-fx-font-size: 11px; -fx-text-fill: #8A817C; -fx-font-weight: bold;"/>

            <Label text="12"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

            <Label text="Awaiting confirmation"
                   style="-fx-font-size: 11px; -fx-text-fill: #B58A45;"/>

        </VBox>

    </HBox>

    <!-- TRANSACTION HISTORY -->
    <VBox spacing="16"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="12">

            <VBox spacing="4">
                <Label text="Recent Transactions"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

                <Label text="A complete list of your cafe transactions."
                       style="-fx-font-size: 12px; -fx-text-fill: #8A817C;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Export"
            onAction="#exportTransactions"
                    style="-fx-background-color: #8B6B4F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>

        </HBox>

        <!-- SEARCH AND FILTER -->
        <HBox spacing="12" alignment="CENTER_LEFT">

            <TextField promptText="Search transaction or customer..."
                       prefWidth="300"
                       style="-fx-background-color: #F8F6F3; -fx-background-radius: 8; -fx-padding: 11;"/>

            <!-- STATUS FILTER -->
            <ComboBox promptText="All Status"
                      prefWidth="150"
                      style="-fx-background-color: #F8F6F3; -fx-background-radius: 8;">

                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Status"/>
                        <String fx:value="Completed"/>
                        <String fx:value="Pending"/>
                        <String fx:value="Cancelled"/>
                    </FXCollections>
                </items>

            </ComboBox>

            <!-- PAYMENT FILTER -->
            <ComboBox promptText="All Payments"
                      prefWidth="160"
                      style="-fx-background-color: #F8F6F3; -fx-background-radius: 8;">

                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Payments"/>
                        <String fx:value="Cash"/>
                        <String fx:value="QRIS"/>
                        <String fx:value="Debit Card"/>
                        <String fx:value="E-Wallet"/>
                    </FXCollections>
                </items>

            </ComboBox>

        </HBox>

        <!-- TRANSACTION TABLE -->
        <TableView fx:id="transactionTable"
           VBox.vgrow="ALWAYS"
           style="-fx-background-color: white;">

    <columns>

        <TableColumn fx:id="idColumn"
                     text="Transaction ID"
                     prefWidth="150"/>

        <TableColumn fx:id="dateColumn"
                     text="Date &amp; Time"
                     prefWidth="180"/>

        <TableColumn fx:id="customerColumn"
                     text="Customer"
                     prefWidth="180"/>

        <TableColumn fx:id="paymentColumn"
                     text="Payment Method"
                     prefWidth="160"/>

        <TableColumn fx:id="amountColumn"
                     text="Amount"
                     prefWidth="160"/>

        <TableColumn fx:id="statusColumn"
                     text="Status"
                     prefWidth="130"/>

    </columns>

</TableView>

    </VBox>

</VBox>