<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24"
       style="-fx-background-color: #F5EFE6; -fx-padding: 32;"
       xmlns="http://javafx.com/javafx/21"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.kafepos.CategoriesController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Categories"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B211D;"/>

            <Label text="Manage your menu categories"
                   style="-fx-font-size: 13px; -fx-text-fill: #8B6B4F;"/>
        </VBox>

        <Button text="+ Add Category"
                onAction="#handleAddCategory"
                style="-fx-background-color: #2B211D; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20;"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search category..."
                   prefWidth="280"
                   style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12;"/>

        <Button text="Search"
                onAction="#handleSearch"
                style="-fx-background-color: #8B6B4F; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20;"/>
    </HBox>

    <TableView fx:id="categoryTable"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="80"/>

            <TableColumn fx:id="nameColumn"
                         text="Category Name"
                         prefWidth="300"/>

            <TableColumn fx:id="actionColumn"
                         text="Actions"
                         prefWidth="200"/>
        </columns>
    </TableView>

</VBox>